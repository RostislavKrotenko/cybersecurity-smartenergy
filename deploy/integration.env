# Обов'язково заміни перед стендовим запуском.
GATEWAY_CONTROL_TOKEN=replace-this-with-a-long-random-token

# Локальний upstream поза Docker.
SMARTENERGY_UPSTREAM_URL=http://host.docker.internal:6006

CYBERSECURITY_GATEWAY_PORT=8080
CYBERSECURITY_API_PORT=6049

GATEWAY_RATE_PER_SECOND=25
GATEWAY_BURST_CAPACITY=50
GATEWAY_COMMAND_RATE_PER_MINUTE=12
GATEWAY_VIOLATION_THRESHOLD=8
GATEWAY_VIOLATION_WINDOW_SEC=30
GATEWAY_BLOCK_TTL_SEC=120
GATEWAY_UPSTREAM_TIMEOUT_SEC=3
GATEWAY_CIRCUIT_FAILURE_THRESHOLD=5
GATEWAY_CIRCUIT_RECOVERY_TIMEOUT_SEC=15
GATEWAY_STALE_CACHE_TTL_SEC=30

COLLECTOR_HTTP_TIMEOUT_SEC=2
COLLECTOR_HTTP_POLL_INTERVAL_SEC=10

# Увімкнемо під час інтеграції зі спільним MQTT broker.
COLLECTOR_MQTT_ENABLED=false
SMARTENERGY_MQTT_HOST=host.docker.internal
SMARTENERGY_MQTT_PORT=6030
SMARTENERGY_MQTT_TOPICS=smartenergy/#
COLLECTOR_MQTT_QOS=1
SMARTENERGY_MQTT_USERNAME=
SMARTENERGY_MQTT_PASSWORD=

CYBERSECURITY_CORS_ORIGINS=http://localhost:5173